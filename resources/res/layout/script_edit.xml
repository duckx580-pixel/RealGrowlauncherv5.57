<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/backgroundstate"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="45dp"
    style="@style/AppCompat">
    <RelativeLayout
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/scriptedit2LinearLayout1"
            android:background="@drawable/folder_icon"
            android:clickable="false"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffffff"
            android:id="@+id/filename"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="My Script"
            android:layout_toRightOf="@+id/scriptedit2LinearLayout1"
            android:layout_centerVertical="true"/>
        <FrameLayout
            android:id="@+id/scripteditButton2"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            style="@style/AppCompat">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/play_icon"
                android:clickable="false"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/scripteditButton1"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/scripteditButton2"
            style="@style/AppCompat">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/edit_icon"
                android:clickable="false"
                android:layout_width="30dp"
                android:layout_height="30dp"/>
        </FrameLayout>
        <View
            android:background="?android:attr/dividerVertical"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/scripteditButton1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/pause"
            android:background="@drawable/icon_pause"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="20dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</FrameLayout>
