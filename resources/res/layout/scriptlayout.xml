<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/main_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <mehdi.sakout.fancybuttons.FancyButton xmlns:fancy="http://schemas.android.com/apk/res-auto"
            android:id="@+id/impor"
            android:padding="10dp"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            fancy:fb_defaultColor="#ff7ab800"
            fancy:fb_focusColor="#ffffffff"
            fancy:fb_fontIconResource=""
            fancy:fb_iconPosition="left"
            fancy:fb_radius="30dp"
            fancy:fb_text=""
            fancy:fb_textColor="#ffffffff"/>
        <mehdi.sakout.fancybuttons.FancyButton
            android:id="@+id/addnew"
            android:padding="10dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            fancy:fb_defaultColor="#ff7ab800"
            fancy:fb_focusColor="#ffffffff"
            fancy:fb_fontIconResource=""
            fancy:fb_iconPosition="left"
            fancy:fb_radius="200dp"
            fancy:fb_text=""
            fancy:fb_textColor="#ffffffff"/>
        <mehdi.sakout.fancybuttons.FancyButton
            android:id="@+id/refresh"
            android:padding="10dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            fancy:fb_defaultColor="#ff7ab800"
            fancy:fb_focusColor="#ffffffff"
            fancy:fb_fontIconResource=""
            fancy:fb_iconPosition="left"
            fancy:fb_radius="200dp"
            fancy:fb_text=""
            fancy:fb_textColor="#ffffffff"/>
        <mehdi.sakout.fancybuttons.FancyButton
            android:id="@+id/back"
            android:padding="10dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            fancy:fb_defaultColor="#ff7ab800"
            fancy:fb_focusColor="#ffffffff"
            fancy:fb_fontIconResource=""
            fancy:fb_iconPosition="right"
            fancy:fb_radius="200dp"
            fancy:fb_text="Back"
            fancy:fb_textColor="#ffffffff"/>
    </LinearLayout>
</RelativeLayout>
