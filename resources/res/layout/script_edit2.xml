<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="45dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/scriptedit2LinearLayout1"
            android:background="@drawable/folder_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ff000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="My Script"
            android:layout_toRightOf="@+id/scriptedit2LinearLayout1"
            android:layout_centerVertical="true"/>
        <FrameLayout
            android:id="@+id/scriptedit2FrameLayout1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/scripteditButton2"
                android:background="@drawable/play_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/scriptedit2FrameLayout1">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/scripteditButton1"
                android:background="@drawable/edit_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"/>
        </FrameLayout>
    </RelativeLayout>
</FrameLayout>
